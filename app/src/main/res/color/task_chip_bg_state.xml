<?xml version="1.0" encoding="utf-8"?>
<!-- Chip fill: a checked category/repeat chip has to look different from an unchecked
     one, so selection is driven by state rather than a flat colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/app_bg_orange" android:state_checked="true" />
    <item android:color="@color/task_chip_bg" />
</selector>
