<?xml version="1.0" encoding="utf-8"?>
<!-- One post in the Reels feed, laid out as a social card: avatar + name header,
     rounded media, then a like / comment / share row with a bookmark on the end. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_12px"
    android:layout_marginTop="@dimen/_6px"
    android:layout_marginEnd="@dimen/_12px"
    android:layout_marginBottom="@dimen/_10px"
    app:cardBackgroundColor="@color/feed_card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12px">

        <!-- ===== Header: avatar, uploader, time, overflow ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="@color/feed_media_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_user"
                    tools:ignore="ContentDescription" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10px"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUploader"
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/feed_name"
                    android:textSize="@dimen/_15sp"
                    tools:text="Michelle Ogilvy" />

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/feed_meta"
                    android:textSize="@dimen/_12sp"
                    tools:text="1h ago" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivMore"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_feed_more"
                android:padding="4dp"
                android:src="@drawable/ic_feed_more"
                app:tint="@color/feed_icon"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- ===== Media ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12px"
            app:cardBackgroundColor="@color/feed_media_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivMedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:maxHeight="420dp"
                    android:minHeight="200dp"
                    android:scaleType="fitCenter"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/placeholder_landscape" />

                <ImageView
                    android:id="@+id/ivPlay"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_badge"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Actions ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12px"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/llLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivLike"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_feed_heart_outline"
                    app:tint="@color/feed_icon"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvLikeCount"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/feed_name"
                    android:textSize="@dimen/_13sp"
                    tools:text="18.6k" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20px"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_feed_comment_outline"
                    app:tint="@color/feed_icon"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvCommentCount"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/feed_name"
                    android:textSize="@dimen/_13sp"
                    tools:text="4.7k" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20px"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_feed_send"
                    app:tint="@color/feed_icon"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llViews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20px"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_feed_eye"
                    app:tint="@color/feed_meta"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvViewCount"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/feed_meta"
                    android:textSize="@dimen/_13sp"
                    tools:text="12.4k" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/ivBookmark"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_feed_bookmark"
                app:tint="@color/feed_icon"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- ===== Caption ===== -->
        <TextView
            android:id="@+id/tvCaption"
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10px"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/feed_caption"
            android:textSize="@dimen/_14sp"
            tools:text="Personalized gifts for every moment" />

        <!-- ===== Post extras: open link / view book ===== -->
        <LinearLayout
            android:id="@+id/llPostExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10px"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvLinkChip"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feed_pill"
                android:drawableStart="@drawable/ic_feed_link"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/_12px"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/_14px"
                android:paddingBottom="6dp"
                android:text="@string/lbl_open_link"
                android:textColor="@color/app_bg_orange"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                app:drawableTint="@color/app_bg_orange"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvBookChip"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8px"
                android:layout_weight="1"
                android:background="@drawable/bg_feed_pill"
                android:drawableStart="@drawable/ic_feed_book"
                android:drawablePadding="6dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="@dimen/_12px"
                android:paddingTop="6dp"
                android:paddingEnd="@dimen/_14px"
                android:paddingBottom="6dp"
                android:text="@string/lbl_view_book"
                android:textColor="@color/app_bg_orange"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                app:drawableTint="@color/app_bg_orange"
                tools:text="View book: Advanced Supply" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
