<?xml version="1.0" encoding="utf-8"?>
<!-- One book in progress: cover, title, the page it stopped at, and a Continue pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llContRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_authx_card_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivContCover"
        android:layout_width="66dp"
        android:layout_height="92dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_portable"
        app:shapeAppearanceOverlay="@style/AuthxCoverShape"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContTitle"
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/authx_text"
            android:textSize="@dimen/_15sp"
            tools:text="Data Structures Through C" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_authx_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_feed_bookmark"
                app:tint="@color/authx_coral"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvContPage"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:textColor="@color/authx_text"
                android:textSize="@dimen/_12sp"
                tools:text="Stopped at page 42" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvContResume"
        style="@style/txt_OpenSansRomanBold"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_authx_pill_cta"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/lbl_cont_resume"
        android:textColor="@color/white"
        android:textSize="@dimen/_13sp" />
</LinearLayout>
