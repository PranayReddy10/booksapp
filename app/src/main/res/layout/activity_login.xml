<?xml version="1.0" encoding="utf-8"?>
<!-- Login: a navy header with the app's mark, and a white card that overlaps it
     holding a Log in / Sign up switch, outlined fields and the actions. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/authx_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Header ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="290dp"
                android:background="@drawable/bg_authx_header"
                android:clipChildren="true">

                <ImageView
                    android:id="@+id/authBlobTeal"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-60dp"
                    android:src="@drawable/bg_authx_ring"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/authBlobViolet"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="-40dp"
                    android:layout_marginBottom="30dp"
                    android:src="@drawable/bg_authx_dot"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="44dp"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_authx_logo"
                            android:padding="6dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@mipmap/ic_launcher_round"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="@string/app_name"
                            android:textColor="@color/authx_on_header"
                            android:textSize="@dimen/_16sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtWelcomeBack"
                        style="@style/txt_OpenSansRomanExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="@string/lbl_authx_welcome"
                        android:textColor="@color/authx_on_header"
                        android:textSize="@dimen/_30sp" />

                    <TextView
                        android:id="@+id/txtAuthSub"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/lbl_authx_welcome_sub"
                        android:textColor="@color/authx_on_header_muted"
                        android:textSize="@dimen/_15sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== Form card ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="-48dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_authx_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <!-- Log in / Sign up switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_authx_soft"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_tab_on"
                        android:elevation="2dp"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/lbl_authx_tab_login"
                        android:textColor="@color/authx_text"
                        android:textSize="@dimen/_15sp" />

                    <TextView
                        android:id="@+id/tvTabSignUp"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="@string/lbl_authx_tab_signup"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="@dimen/_15sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/lbl_authx_email"
                    app:startIconDrawable="@drawable/ic_reg_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_pass"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_reg_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPass"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Remember me / forgot -->
                <RelativeLayout
                    android:id="@+id/linearRowrememberme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <cn.refactor.library.SmoothCheckBox
                        android:id="@+id/cbRemMe"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:color_checked="@color/authx_coral"
                        app:color_tick="@color/white"
                        app:color_unchecked="@color/authx_field"
                        app:color_unchecked_stroke="@color/authx_field_stroke" />

                    <TextView
                        android:id="@+id/txtMe"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/cbRemMe"
                        android:text="@string/lbl_remember_me"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="@dimen/_14sp" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="4dp"
                        android:text="@string/msg_forgot_password"
                        android:textColor="@color/authx_coral"
                        android:textSize="@dimen/_14sp" />
                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLogIn"
                    style="@style/txtOpenSansRomanBold"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_authx_cta"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:stateListAnimator="@null"
                    android:text="@string/lbl_authx_login_btn"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_16sp" />

                <!-- or -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_divider" />

                    <TextView
                        android:id="@+id/txtOrcontinuewit"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/lbl_authx_or"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="@dimen/_13sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_divider" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_authx_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageGoogle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/img_google"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/txtGoogleOne"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/lbl_authx_google"
                        android:textColor="@color/authx_text"
                        android:textSize="@dimen/_15sp" />
                </LinearLayout>

                <!-- Terms -->
                <RelativeLayout
                    android:id="@+id/linearRowPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp">

                    <cn.refactor.library.SmoothCheckBox
                        android:id="@+id/cbPrivacyTerms"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:color_checked="@color/authx_coral"
                        app:color_tick="@color/white"
                        app:color_unchecked="@color/authx_field"
                        app:color_unchecked_stroke="@color/authx_field_stroke" />

                    <TextView
                        android:id="@+id/txtPrivacyText"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/cbPrivacyTerms"
                        android:singleLine="true"
                        android:text="@string/msg_by_signing_in_y"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="@dimen/_13sp" />

                    <TextView
                        android:id="@+id/tvPrivacyTerms"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="4dp"
                        android:layout_toEndOf="@+id/txtPrivacyText"
                        android:singleLine="true"
                        android:text="@string/msg_by_signing_up_policy"
                        android:textColor="@color/authx_coral"
                        android:textSize="@dimen/_13sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- ===== Footer ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/msg_don_t_have_an_a"
                    android:textColor="@color/authx_text_muted"
                    android:textSize="@dimen/_14sp" />

                <TextView
                    android:id="@+id/tvSignUp"
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_sign_up"
                    android:textColor="@color/authx_coral"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
