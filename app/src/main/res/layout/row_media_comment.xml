<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_12px"
    android:paddingTop="@dimen/_8px"
    android:paddingEnd="@dimen/_12px"
    android:paddingBottom="@dimen/_8px">

    <androidx.cardview.widget.CardView
        android:id="@+id/cvCommentAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_alignParentStart="true"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_user"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvCommentUser"
        style="@style/txt_OpenSansRomanBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10px"
        android:layout_toEndOf="@+id/cvCommentAvatar"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/gray_2"
        android:textSize="@dimen/_14sp"
        tools:text="Pranay" />

    <TextView
        android:id="@+id/tvCommentTime"
        style="@style/txtOpenSansRomanSemiBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:textColor="@color/gray_trans_99"
        android:textSize="11sp"
        tools:text="2h" />

    <TextView
        android:id="@+id/tvCommentText"
        style="@style/txtOpenSansRomanSemiBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvCommentUser"
        android:layout_marginStart="@dimen/_10px"
        android:layout_marginTop="2dp"
        android:layout_toEndOf="@+id/cvCommentAvatar"
        android:textColor="@color/gray_2"
        android:textSize="@dimen/_14sp"
        tools:text="This is a sample comment that can span multiple lines." />
</RelativeLayout>
