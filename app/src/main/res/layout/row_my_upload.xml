<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5px"
        android:layout_marginTop="@dimen/_5px"
        android:layout_marginEnd="@dimen/_5px"
        android:layout_marginBottom="@dimen/_8px"
        app:rippleColor="@android:color/transparent"
        app:cardBackgroundColor="@color/card_view_bg"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp">

        <RelativeLayout
            android:id="@+id/llUploadGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.github.siyamed.shapeimageview.mask.PorterShapeImageView
                android:id="@+id/ivUploadCover"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_gravity="start"
                android:scaleType="fitXY"
                android:src="@drawable/placeholder_portable"
                app:siShape="@drawable/image_book_shape"
                tools:ignore="ContentDescription"
                tools:src="@drawable/placeholder_portable" />

            <!-- Status badge overlaid on the cover -->
            <TextView
                android:id="@+id/tvUploadStatus"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_8px"
                android:paddingStart="@dimen/_10px"
                android:paddingTop="@dimen/_3px"
                android:paddingEnd="@dimen/_10px"
                android:paddingBottom="@dimen/_3px"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:text="Pending" />

            <TextView
                android:id="@+id/tvUploadTitle"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ivUploadCover"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_5px"
                android:layout_marginEnd="@dimen/_8px"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/gray_2"
                android:textSize="@dimen/_15sp"
                tools:text="@string/app_name" />

            <!-- Views, readers and coins for this one book. -->
            <TextView
                android:id="@+id/tvUploadEarnings"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvUploadTitle"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_2px"
                android:layout_marginEnd="@dimen/_8px"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/app_bg_orange"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                tools:text="1,204 views · 86 readers · +86"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvUploadReason"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvUploadEarnings"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_1px"
                android:layout_marginEnd="@dimen/_8px"
                android:layout_marginBottom="@dimen/_8px"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/home_by_author"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                tools:text="Reason: blurry scan" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
