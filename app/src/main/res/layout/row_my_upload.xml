<?xml version="1.0" encoding="utf-8"?>
<!-- One uploaded book: cover, title, a status pill (pending / approved /
     rejected), what it has earned once approved, and the reason if rejected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mcUpload"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_authx_card_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivUploadCover"
        android:layout_width="66dp"
        android:layout_height="92dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_portable"
        app:shapeAppearanceOverlay="@style/AuthxCoverShape"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llUploadGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvUploadStatus"
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textSize="@dimen/_12sp"
            tools:text="Approved" />

        <TextView
            android:id="@+id/tvUploadTitle"
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/authx_text"
            android:textSize="@dimen/_15sp"
            tools:text="Operating Systems Notes - Unit 3" />

        <!-- Views, readers and coins for this one book. -->
        <TextView
            android:id="@+id/tvUploadEarnings"
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/authx_coral"
            android:textSize="@dimen/_12sp"
            android:visibility="gone"
            tools:text="1,204 views · 86 readers · +86 coins"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvUploadReason"
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_authx_soft"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="@color/authx_text_muted"
            android:textSize="@dimen/_12sp"
            android:visibility="gone"
            tools:text="Reason: blurry scan" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_home_chevron"
        app:tint="@color/authx_text_muted"
        tools:ignore="ContentDescription" />
</LinearLayout>
