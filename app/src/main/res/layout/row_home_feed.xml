<?xml version="1.0" encoding="utf-8"?>
<!-- Community post on home: a tall story card, deliberately unlike the book covers
     beside it — media fills the tile, a scrim carries the caption, and videos show
     a play badge. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="132dp"
        android:layout_height="196dp"
        android:layout_marginEnd="@dimen/_12px"
        android:layout_marginTop="@dimen/_6px"
        android:layout_marginBottom="@dimen/_6px"
        app:cardBackgroundColor="@color/home_cover_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivHomeFeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_portable"
                tools:ignore="ContentDescription" />

            <!-- Scrim so the caption stays readable over any photo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_scrim_bottom" />

            <ImageView
                android:id="@+id/ivHomeFeedPlay"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_badge"
                android:visibility="gone"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvHomeFeedTitle"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/_10px"
                android:layout_marginEnd="@dimen/_10px"
                android:layout_marginBottom="@dimen/_10px"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sp"
                tools:text="Exam timetable is out" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
