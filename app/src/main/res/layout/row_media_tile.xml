<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_3px"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_view_bg">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Fixed-ratio tile; height set per-item in the adapter for a staggered look -->
        <ImageView
            android:id="@+id/ivTile"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:adjustViewBounds="true"
            android:background="@color/card_view_bg"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription" />

        <!-- Media-type badge, top-left (photo/video/link glyph like the reference grid) -->
        <ImageView
            android:id="@+id/ivTileBadge"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="@dimen/_8px"
            android:background="@drawable/bg_tile_badge"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />

        <!-- View count, bottom-left (only when show_views is on) -->
        <LinearLayout
            android:id="@+id/llTileViews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_margin="@dimen/_8px"
            android:background="@drawable/bg_tile_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_view"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvTileViews"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:text="25" />
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
