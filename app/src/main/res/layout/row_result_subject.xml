<?xml version="1.0" encoding="utf-8"?>
<!-- One table row. Column widths match the header in row_result_semester.xml;
     both sit inside the same horizontal scroller, so they stay aligned. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="42dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="154dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingEnd="8dp"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/tvSubName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/opensansromansemibold"
            android:maxLines="2"
            android:textColor="@color/gray"
            android:textSize="12sp"
            tools:text="CRYPTOGRAPHY &amp; NETWORK SECURITY" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSubCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensansromansemibold"
                android:textColor="@color/gray_2"
                android:textSize="10sp"
                tools:text="157BB" />

            <TextView
                android:id="@+id/tagBacklog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_backlog_tag"
                android:fontFamily="@font/opensansromanbold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/result_backlog_tag"
                android:textColor="@color/result_backlog_red"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubInternal"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensansromansemibold"
        android:gravity="center"
        android:textColor="@color/gray"
        android:textSize="12sp"
        tools:text="20" />

    <TextView
        android:id="@+id/tvSubExternal"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensansromansemibold"
        android:gravity="center"
        android:textColor="@color/gray"
        android:textSize="12sp"
        tools:text="31" />

    <TextView
        android:id="@+id/tvSubTotal"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensansromanbold"
        android:gravity="center"
        android:textColor="@color/gray"
        android:textSize="12sp"
        tools:text="51" />

    <TextView
        android:id="@+id/tvSubGrade"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensansromanextrabold"
        android:gravity="center"
        android:textColor="@color/result_brand_blue"
        android:textSize="12.5sp"
        tools:text="B" />

    <TextView
        android:id="@+id/tvSubCredits"
        android:layout_width="46dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/opensansromanbold"
        android:gravity="center"
        android:textColor="@color/gray"
        android:textSize="12sp"
        tools:text="3.0" />
</LinearLayout>
