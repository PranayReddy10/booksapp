<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_bg">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white"
        android:elevation="3dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/ic_result_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/result_back" />

        <TextView
            android:id="@+id/tvEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/result_add_title"
            android:textColor="@color/gray"
            android:textSize="18sp"
            android:fontFamily="@font/opensansromanextrabold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Basic details card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/ResultFieldLabel"
                        android:text="@string/result_hall_ticket_label" />

                    <EditText
                        android:id="@+id/etHallTicket"
                        style="@style/ResultInput"
                        android:hint="@string/result_hall_ticket_hint"
                        android:inputType="textCapCharacters"
                        android:maxLength="12"
                        android:importantForAutofill="no" />

                    <TextView
                        style="@style/ResultFieldLabel"
                        android:text="@string/result_name_label" />

                    <EditText
                        android:id="@+id/etStudentName"
                        style="@style/ResultInput"
                        android:hint="@string/result_name_hint"
                        android:inputType="textCapWords"
                        android:importantForAutofill="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                style="@style/ResultFieldLabel"
                                android:text="@string/result_branch_label" />

                            <Spinner
                                android:id="@+id/spBranch"
                                style="@style/ResultSpinner" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                style="@style/ResultFieldLabel"
                                android:text="@string/result_regulation_label" />

                            <Spinner
                                android:id="@+id/spRegulation"
                                style="@style/ResultSpinner" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/ResultFieldLabel"
                        android:text="@string/result_degree_label" />

                    <EditText
                        android:id="@+id/etDegree"
                        style="@style/ResultInput"
                        android:hint="@string/result_degree_hint"
                        android:inputType="textCapCharacters"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Semesters section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/result_semesters"
                    android:textColor="@color/gray"
                    android:textSize="16sp"
                    android:fontFamily="@font/opensansromanextrabold" />
            </LinearLayout>

            <!-- Semester editor blocks injected here -->
            <LinearLayout
                android:id="@+id/llSemesterEditors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp" />

            <!-- Add semester -->
            <LinearLayout
                android:id="@+id/btnAddSemester"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_result_btn_outline"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_result_add"
                    app:tint="@color/result_brand_blue"
                    android:contentDescription="@string/result_add_semester" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_add_semester"
                    android:textColor="@color/result_brand_blue"
                    android:textSize="13sp"
                    android:fontFamily="@font/opensansromanbold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="14dp">

        <LinearLayout
            android:id="@+id/btnSaveResult"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_result_btn_primary"
            android:foreground="?attr/selectableItemBackground">

            <ProgressBar
                android:id="@+id/progressSave"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSaveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_save"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/opensansromanbold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
