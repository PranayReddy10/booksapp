<?xml version="1.0" encoding="utf-8"?>
<!-- One option in a searchable picker. The selected option is outlined and carries a
     check, so the list reads as a choice rather than a plain dropdown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llItemRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_6px"
    android:background="@drawable/bg_picker_row"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/_16px"
    android:paddingEnd="@dimen/_12px">

    <TextView
        android:id="@+id/tvItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="@dimen/_12px"
        android:paddingBottom="@dimen/_12px"
        android:textColor="@color/gray_2"
        android:textSize="16sp"
        tools:text="Hindi" />

    <ImageView
        android:id="@+id/ivItemCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_picker_check"
        android:visibility="invisible"
        app:tint="@color/app_bg_orange"
        tools:ignore="ContentDescription"
        tools:visibility="visible" />
</LinearLayout>
