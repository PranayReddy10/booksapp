<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password in the login screen's look: navy header with a back button and
     the explanation, a white card with the email field and one action. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/authx_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Header ===== -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_authx_header">

                <ImageView
                    android:id="@+id/authBlobRing"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-70dp"
                    android:layout_marginEnd="-60dp"
                    android:src="@drawable/bg_authx_ring"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="36dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="72dp">

                    <ImageView
                        android:id="@+id/btnForgotBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_authx_glass"
                        android:contentDescription="@string/lbl_authx_back_login"
                        android:padding="9dp"
                        android:src="@drawable/ic_reg_back"
                        app:tint="@color/authx_on_header" />

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_authx_glass">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_reg_lock"
                            app:tint="@color/authx_on_header"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtForgotPassword2"
                        style="@style/txt_OpenSansRomanExtraBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/lbl_authx_forgot_title"
                        android:textColor="@color/authx_on_header"
                        android:textSize="@dimen/_30sp" />

                    <TextView
                        android:id="@+id/txtForgotPassword3"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/lbl_authx_forgot_sub"
                        android:textColor="@color/authx_on_header_muted"
                        android:textSize="@dimen/_15sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- ===== Form card ===== -->
            <LinearLayout
                android:id="@+id/linearLoginFild"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="-48dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_authx_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:hint="@string/lbl_authx_email"
                    app:startIconDrawable="@drawable/ic_reg_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtForgotEmail"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnForgotSend"
                    style="@style/txtOpenSansRomanBold"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_authx_cta"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:stateListAnimator="@null"
                    android:text="@string/lbl_authx_send_link"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_16sp" />
            </LinearLayout>

            <!-- ===== Footer ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="28dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/lbl_authx_remembered"
                    android:textColor="@color/authx_text_muted"
                    android:textSize="@dimen/_14sp" />

                <TextView
                    android:id="@+id/tvForgotLogin"
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_authx_back_login"
                    android:textColor="@color/authx_coral"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
