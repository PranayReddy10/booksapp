<?xml version="1.0" encoding="utf-8"?>
<!-- One post = one full screen, immersive style: media fills the frame, header and
     a right-side action rail overlay on top with scrims for legibility. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ===== Media (fills the whole screen) ===== -->
    <FrameLayout
        android:id="@+id/flMedia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/ivBlurBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <View
            android:id="@+id/vBlurScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:resize_mode="fit"
            app:use_controller="false" />

        <ImageView
            android:id="@+id/ivVideoPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <ProgressBar
            android:id="@+id/progressVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Top scrim for header legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_scrim_top"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom scrim for caption legibility -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ===== Header (overlay, top) ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvAvatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="@dimen/_16px"
        android:layout_marginTop="@dimen/_60px"
        app:cardCornerRadius="21dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_user"
            tools:ignore="ContentDescription" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvUploader"
        style="@style/txt_OpenSansRomanBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10px"
        android:ellipsize="end"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="@dimen/_16sp"
        app:layout_constraintEnd_toStartOf="@+id/btnFollow"
        app:layout_constraintStart_toEndOf="@+id/cvAvatar"
        app:layout_constraintTop_toTopOf="@+id/cvAvatar"
        tools:text="Admin" />

    <TextView
        android:id="@+id/tvTime"
        style="@style/txtOpenSansRomanSemiBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10px"
        android:ellipsize="end"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:singleLine="true"
        android:textColor="#DDFFFFFF"
        android:textSize="@dimen/_12sp"
        app:layout_constraintBottom_toBottomOf="@+id/cvAvatar"
        app:layout_constraintStart_toEndOf="@+id/cvAvatar"
        app:layout_constraintTop_toBottomOf="@+id/tvUploader"
        tools:text="1 day ago" />

    <TextView
        android:id="@+id/btnFollow"
        style="@style/txt_OpenSansRomanBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_16px"
        android:background="@drawable/bg_follow_btn"
        android:paddingStart="@dimen/_16px"
        android:paddingTop="6dp"
        android:paddingEnd="@dimen/_16px"
        android:paddingBottom="6dp"
        android:text="@string/lbl_follow"
        android:textColor="@color/white"
        android:textSize="@dimen/_13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/cvAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cvAvatar" />

    <!-- ===== Right-side action rail (overlay) ===== -->
    <LinearLayout
        android:id="@+id/barActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_12px"
        android:layout_marginBottom="@dimen/_20px"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Like -->
        <LinearLayout
            android:id="@+id/llLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_18px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivLike"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_feed_heart_outline"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvLikeCount"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sp"
                tools:text="12" />
        </LinearLayout>

        <!-- Comment -->
        <LinearLayout
            android:id="@+id/llComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_18px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivComment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_feed_comment"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvCommentCount"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sp"
                tools:text="3" />
        </LinearLayout>

        <!-- Views (count only, no tap) -->
        <LinearLayout
            android:id="@+id/llViewsRail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_18px"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_feed_eye"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvViewRail"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="@color/white"
                android:textSize="@dimen/_12sp"
                tools:text="14" />
        </LinearLayout>

        <!-- Share -->
        <ImageView
            android:id="@+id/ivShare"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="@dimen/_18px"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_feed_share"
            tools:ignore="ContentDescription" />

        <!-- Bookmark (display only for now) -->
        <ImageView
            android:id="@+id/ivBookmark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_feed_bookmark"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- ===== "View book" bar (shows when the post is linked to a book) ===== -->
    <LinearLayout
        android:id="@+id/btnViewBook"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16px"
        android:layout_marginEnd="@dimen/_16px"
        android:layout_marginBottom="@dimen/_10px"
        android:background="@drawable/bg_view_book"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_16px"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/_14px"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/tvLinkChip"
        app:layout_constraintEnd_toStartOf="@+id/barActions"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_feed_book"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/tvViewBookLabel"
            style="@style/txt_OpenSansRomanBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/lbl_view_book"
            android:textColor="@color/white"
            android:textSize="@dimen/_15sp"
            tools:text="View book: Advanced Supply" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_feed_chevron"
            app:tint="@color/white"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- ===== Open-link chip (bottom-left, above caption) ===== -->
    <TextView
        android:id="@+id/tvLinkChip"
        style="@style/txt_OpenSansRomanBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16px"
        android:layout_marginBottom="@dimen/_10px"
        android:background="@drawable/bg_follow_btn"
        android:drawableStart="@drawable/ic_feed_link"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/_14px"
        android:paddingTop="7dp"
        android:paddingEnd="@dimen/_16px"
        android:paddingBottom="7dp"
        android:text="@string/lbl_open_link"
        android:textColor="@color/white"
        android:textSize="@dimen/_13sp"
        android:visibility="gone"
        app:drawableTint="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/tvCaption"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ===== Caption (bottom, overlay) ===== -->
    <TextView
        android:id="@+id/tvCaption"
        style="@style/txtOpenSansRomanSemiBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16px"
        android:layout_marginEnd="@dimen/_12px"
        android:layout_marginBottom="@dimen/_20px"
        android:ellipsize="end"
        android:maxLines="3"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="@color/white"
        android:textSize="@dimen/_15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barActions"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Personalized gifts for every moment" />

</androidx.constraintlayout.widget.ConstraintLayout>
