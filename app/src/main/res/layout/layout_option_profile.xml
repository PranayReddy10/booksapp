<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical" >

    <View
        android:id="@+id/line"
        android:layout_width="@dimen/_70px"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginStart="@dimen/_20px"
        android:layout_marginTop="@dimen/_20px"
        android:layout_marginEnd="@dimen/_20px"
        android:background="@drawable/rectangle_bg_view_line_intro" />

    <RelativeLayout
        android:id="@+id/layDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:layout_marginTop="20dp"
        android:background="?attr/selectableItemBackground" >

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArwDown"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/tab_download"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/tab_download" />

        <ImageView
            android:id="@+id/ivEdArwDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layFav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground">

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArwFav"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/tab_favorite"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/tab_favorite" />

        <ImageView
            android:id="@+id/ivEdArwFav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layUploadBook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground">

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArwUpload"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/lbl_upload_book"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/lbl_upload_book" />

        <ImageView
            android:id="@+id/ivEdArwUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layMyUploads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground">

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArwMyUploads"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/lbl_my_uploads"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/lbl_my_uploads" />

        <ImageView
            android:id="@+id/ivEdArwMyUploads"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layMyMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground">

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArwMyMedia"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/lbl_my_media"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/lbl_my_media" />

        <ImageView
            android:id="@+id/ivEdArwMyMedia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layEditProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground">

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArw1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/profile_edt_title"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/profile_edt_title" />

        <ImageView
            android:id="@+id/ivEdArw1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/txtWriteYourReview"
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArw"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/logout"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/logout" />

        <ImageView
            android:id="@+id/ivEdArw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/layDeleteAcc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/_15px"
        android:paddingHorizontal="@dimen/_20px"
        android:background="?attr/selectableItemBackground"
        android:layout_marginBottom="20dp">

        <TextView
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_gravity="start"
            android:layout_toStartOf="@+id/ivEdArw2"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/delete_acc"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_17sp"
            tools:text="@string/delete_acc" />

        <ImageView
            android:id="@+id/ivEdArw2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_arrow_setting" />

    </RelativeLayout>

</LinearLayout>
