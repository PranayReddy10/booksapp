<?xml version="1.0" encoding="UTF-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_5px"
        android:layout_marginTop="@dimen/_5px"
        android:layout_marginEnd="@dimen/_5px"
        android:layout_marginBottom="@dimen/_8px"
        app:rippleColor="@android:color/transparent"
        app:cardBackgroundColor="@color/card_view_bg"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivMediaThumb"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:scaleType="centerCrop"
                android:background="@color/card_view_bg"
                tools:ignore="ContentDescription" />

            <!-- Play glyph for video rows -->
            <ImageView
                android:id="@+id/ivPlayBadge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignTop="@+id/ivMediaThumb"
                android:layout_alignBottom="@+id/ivMediaThumb"
                android:layout_centerHorizontal="true"
                android:background="@drawable/bg_circle_scrim"
                android:padding="10dp"
                android:src="@android:drawable/ic_media_play"
                android:visibility="gone"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvMediaStatus"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_8px"
                android:paddingStart="@dimen/_10px"
                android:paddingTop="@dimen/_3px"
                android:paddingEnd="@dimen/_10px"
                android:paddingBottom="@dimen/_3px"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="11sp"
                tools:text="Pending" />

            <!-- Delete button -->
            <ImageView
                android:id="@+id/ivMediaDelete"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/_8px"
                android:layout_marginEnd="@dimen/_8px"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tvMediaTitle"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ivMediaThumb"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_5px"
                android:layout_marginEnd="@dimen/_8px"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/gray_2"
                android:textSize="@dimen/_15sp"
                tools:text="My video caption" />

            <TextView
                android:id="@+id/tvMediaReason"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tvMediaTitle"
                android:layout_marginStart="@dimen/_8px"
                android:layout_marginTop="@dimen/_1px"
                android:layout_marginEnd="@dimen/_8px"
                android:layout_marginBottom="@dimen/_8px"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/home_by_author"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                tools:text="Reason: off-topic" />

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
