<?xml version="1.0" encoding="utf-8"?>
<!-- One attachment in the composer's strip: thumbnail, remove button, and a cover
     badge on the first photo (that's the one the feed shows). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="96dp"
    android:layout_height="96dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|start"
        app:cardBackgroundColor="@color/home_cover_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivComposeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:ignore="ContentDescription"
            tools:src="@drawable/placeholder_landscape" />

        <TextView
            android:id="@+id/tvComposeCover"
            style="@style/txtOpenSansRomanSemiBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rating_pill"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/lbl_cover"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </com.google.android.material.card.MaterialCardView>

    <ImageView
        android:id="@+id/ivComposeRemove"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_circle_scrim"
        android:padding="5dp"
        android:src="@drawable/ic_compose_close"
        app:tint="@color/white"
        tools:ignore="ContentDescription" />
</FrameLayout>
