<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/task_screen_bg"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/task_surface"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="12dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_back"
            android:padding="9dp"
            android:src="@drawable/ic_result_back" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/opensansromanextrabold"
            android:text="@string/task_new"
            android:textColor="@color/task_title"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/ivDelete"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_delete"
            android:padding="10dp"
            android:src="@drawable/ic_task_trash"
            android:visibility="gone"
            app:tint="@color/task_overdue"
            tools:visibility="visible" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Title -->
            <EditText
                android:id="@+id/edtTitle"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_task_field"
                android:hint="@string/task_hint_title"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:minHeight="54dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textColor="@color/task_title"
                android:textColorHint="@color/task_muted"
                android:textSize="15sp"
                tools:ignore="Autofill" />

            <!-- Notes -->
            <EditText
                android:id="@+id/edtNotes"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_task_field"
                android:gravity="top"
                android:hint="@string/task_hint_notes"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="88dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textColor="@color/task_title"
                android:textColorHint="@color/task_muted"
                android:textSize="14sp"
                tools:ignore="Autofill" />

            <!-- Category -->
            <TextView
                style="@style/txt_OpenSansRomanExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/task_label_category"
                android:textColor="@color/task_title"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleLine="false"
                app:singleSelection="true" />

            <!-- Date & time -->
            <TextView
                style="@style/txt_OpenSansRomanExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/task_label_when"
                android:textColor="@color/task_title"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/llPickDate"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_task_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_task_calendar"
                        app:tint="@color/app_bg_orange"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvPickDate"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/task_title"
                        android:textSize="13sp"
                        tools:text="16 Aug 2026" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPickTime"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_task_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_task_clock"
                        app:tint="@color/app_bg_orange"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tvPickTime"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/task_title"
                        android:textSize="13sp"
                        tools:text="8:00 PM" />
                </LinearLayout>
            </LinearLayout>

            <!-- Repeat -->
            <TextView
                style="@style/txt_OpenSansRomanExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/task_label_repeat"
                android:textColor="@color/task_title"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:singleLine="false"
                app:singleSelection="true" />

            <!-- Reminder type -->
            <TextView
                style="@style/txt_OpenSansRomanExtraBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/task_label_remind"
                android:textColor="@color/task_title"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgRemind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_task_field"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <RadioButton
                    android:id="@+id/rbRemindNotification"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/app_bg_orange"
                    android:minHeight="44dp"
                    android:text="@string/task_remind_notification"
                    android:textColor="@color/task_title"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRemindAlarm"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/app_bg_orange"
                    android:minHeight="44dp"
                    android:text="@string/task_remind_alarm"
                    android:textColor="@color/task_title"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbRemindNone"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/app_bg_orange"
                    android:minHeight="44dp"
                    android:text="@string/task_remind_none"
                    android:textColor="@color/task_title"
                    android:textSize="14sp" />
            </RadioGroup>

            <!-- Lead time / snooze / tone: only relevant when a reminder is on -->
            <LinearLayout
                android:id="@+id/llReminderOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/txt_OpenSansRomanExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/task_label_lead"
                    android:textColor="@color/task_title"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spLead"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_task_field"
                    android:paddingHorizontal="14dp" />

                <TextView
                    style="@style/txt_OpenSansRomanExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/task_label_snooze"
                    android:textColor="@color/task_title"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spSnooze"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_task_field"
                    android:paddingHorizontal="14dp" />

                <!-- Tone picker, alarm reminders only -->
                <LinearLayout
                    android:id="@+id/llTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/txt_OpenSansRomanExtraBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_label_tone"
                        android:textColor="@color/task_title"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/llPickTone"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_task_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_task_alarm"
                            app:tint="@color/app_bg_orange"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/tvToneName"
                            style="@style/txtOpenSansRomanSemiBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/task_tone_default"
                            android:textColor="@color/task_title"
                            android:textSize="13sp" />

                        <TextView
                            style="@style/txtOpenSansRomanSemiBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/task_tone_pick"
                            android:textColor="@color/app_bg_orange"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/task_surface"
        android:elevation="8dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_task_cta"
            android:fontFamily="@font/opensansromanextrabold"
            android:gravity="center"
            android:text="@string/task_save"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
