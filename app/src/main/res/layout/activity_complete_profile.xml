<?xml version="1.0" encoding="utf-8"?>
<!-- Completing a profile is enrolment, not a settings form. Google gives only a name
     and email, so this asks for the rest of what sign-up asks for: phone and gender
     on one card, the campus choices as numbered steps on another, then one action.
     Matches the registration flow's look. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- ===== Heading ===== -->
    <LinearLayout
        android:id="@+id/llCompleteHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/_20px"
        android:layout_marginTop="@dimen/_30px"
        android:layout_marginEnd="@dimen/_20px"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_reg_badge">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_result_school"
                app:tint="@color/app_bg_orange"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_15px"
            android:fontFamily="@font/opensansromanextrabold"
            android:text="@string/lbl_complete_profile"
            android:textColor="@color/gray_2"
            android:textSize="@dimen/_24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6px"
            android:fontFamily="@font/opensansromansemibold"
            android:text="@string/lbl_complete_profile_sub"
            android:textColor="@color/home_by_author"
            android:textSize="@dimen/_15sp" />
    </LinearLayout>

    <!-- ===== Action ===== -->
    <LinearLayout
        android:id="@+id/llCompleteActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/_20px"
        android:layout_marginEnd="@dimen/_20px"
        android:layout_marginBottom="@dimen/_20px"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/progressComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/_12px"
            android:theme="@style/ProgressBar"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSaveProfile"
            style="@style/txtOpenSansRomanBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_auth_cta"
            android:gravity="center"
            android:paddingTop="@dimen/_16px"
            android:paddingBottom="@dimen/_16px"
            android:singleLine="true"
            android:text="@string/lbl_continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sp" />
    </LinearLayout>

    <!-- ===== Campus choices ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llCompleteActions"
        android:layout_below="@+id/llCompleteHeader"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- ===== About you: what Google does not tell us ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20px"
            android:layout_marginTop="@dimen/_20px"
            android:layout_marginEnd="@dimen/_20px"
            android:background="@drawable/bg_reg_card"
            android:orientation="vertical"
            android:padding="@dimen/_20px">

            <TextView
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_14px"
                android:text="@string/lbl_cp_about_you"
                android:textColor="@color/gray_2"
                android:textSize="@dimen/_16sp" />

            <!-- Email comes from Google and is the sign-in, so it is shown, not edited. -->
            <TextView
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_email"
                android:textColor="@color/home_by_author"
                android:textSize="@dimen/_13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:alpha="0.75"
                android:background="@drawable/bg_reg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_16px"
                android:paddingTop="@dimen/_16px"
                android:paddingEnd="@dimen/_16px"
                android:paddingBottom="@dimen/_16px">

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:src="@drawable/ic_reg_mail"
                    app:tint="@color/app_bg_orange"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvCpEmail"
                    style="@style/txt_PoppinsMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12px"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/gray_2"
                    android:textSize="@dimen/_15sp"
                    tools:text="student@gmail.com" />

                <ImageView
                    android:layout_width="@dimen/_18px"
                    android:layout_height="@dimen/_18px"
                    android:src="@drawable/ic_reg_lock"
                    app:tint="@color/home_by_author"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <TextView
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18px"
                android:text="@string/lbl_phone_req"
                android:textColor="@color/home_by_author"
                android:textSize="@dimen/_13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:background="@drawable/bg_reg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_16px"
                android:paddingEnd="@dimen/_16px">

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:src="@drawable/ic_reg_phone"
                    app:tint="@color/app_bg_orange"
                    tools:ignore="ContentDescription" />

                <TextView
                    style="@style/txt_PoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12px"
                    android:text="@string/lbl_phone_country_code"
                    android:textColor="@color/gray_2"
                    android:textSize="@dimen/_15sp" />

                <EditText
                    android:id="@+id/edtCpPhone"
                    style="@style/txt_PoppinsMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8px"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/lbl_phone_hint_10"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:paddingTop="@dimen/_16px"
                    android:paddingBottom="@dimen/_16px"
                    android:singleLine="true"
                    android:textColor="@color/gray_2"
                    android:textColorHint="@color/gray_edt_hint_text"
                    android:textCursorDrawable="@drawable/cursor"
                    android:textSize="@dimen/_15sp"
                    tools:ignore="Autofill" />
            </LinearLayout>

            <TextView
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18px"
                android:text="@string/lbl_gender_req"
                android:textColor="@color/home_by_author"
                android:textSize="@dimen/_13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10px"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/llCpGenderMale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2px"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_4px"
                    android:paddingBottom="@dimen/_4px">

                    <FrameLayout
                        android:id="@+id/ivCpGenderMaleDisc"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_gender_circle">

                        <ImageView
                            android:id="@+id/ivCpGenderMale"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gender_male"
                            app:tint="@color/home_by_author"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCpGenderMale"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6px"
                        android:text="@string/lbl_gender_male"
                        android:textColor="@color/home_by_author"
                        android:textSize="@dimen/_13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCpGenderFemale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8px"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_4px"
                    android:paddingBottom="@dimen/_4px">

                    <FrameLayout
                        android:id="@+id/ivCpGenderFemaleDisc"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_gender_circle">

                        <ImageView
                            android:id="@+id/ivCpGenderFemale"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gender_female"
                            app:tint="@color/home_by_author"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCpGenderFemale"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6px"
                        android:text="@string/lbl_gender_female"
                        android:textColor="@color/home_by_author"
                        android:textSize="@dimen/_13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCpGenderOther"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8px"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_4px"
                    android:paddingBottom="@dimen/_4px">

                    <FrameLayout
                        android:id="@+id/ivCpGenderOtherDisc"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_gender_circle">

                        <ImageView
                            android:id="@+id/ivCpGenderOther"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_gender_other"
                            app:tint="@color/home_by_author"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvCpGenderOther"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6px"
                        android:text="@string/lbl_gender_other"
                        android:textColor="@color/home_by_author"
                        android:textSize="@dimen/_13sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ===== Your campus ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20px"
            android:layout_marginTop="@dimen/_16px"
            android:layout_marginEnd="@dimen/_20px"
            android:layout_marginBottom="@dimen/_20px"
            android:background="@drawable/bg_reg_card"
            android:orientation="vertical"
            android:padding="@dimen/_20px">

            <TextView
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_14px"
                android:text="@string/lbl_cp_your_campus"
                android:textColor="@color/gray_2"
                android:textSize="@dimen/_16sp" />

            <!-- 1. University -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_reg_badge"
                    android:gravity="center"
                    android:text="@string/lbl_step_1"
                    android:textColor="@color/app_bg_orange"
                    android:textSize="@dimen/_12sp" />

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10px"
                    android:text="@string/lbl_university_req"
                    android:textColor="@color/home_by_author"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:background="@drawable/bg_reg_field"
                android:minHeight="@dimen/_55px">

                <Spinner
                    android:id="@+id/spUniversity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/_16px"
                    android:paddingEnd="@dimen/_40px"
                    android:spinnerMode="dropdown"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_16px"
                    android:src="@drawable/img_arrow_dropdown"
                    app:tint="@color/home_by_author"
                    tools:ignore="ContentDescription" />
            </RelativeLayout>

            <!-- 2. Hall ticket — the lookup that fills in the rest -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_reg_badge"
                    android:gravity="center"
                    android:text="@string/lbl_step_2"
                    android:textColor="@color/app_bg_orange"
                    android:textSize="@dimen/_12sp" />

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10px"
                    android:text="@string/lbl_roll_req"
                    android:textColor="@color/home_by_author"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:background="@drawable/bg_reg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_16px"
                android:paddingEnd="@dimen/_16px">

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:src="@drawable/ic_reg_badge_id"
                    app:tint="@color/app_bg_orange"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/edtCpRoll"
                    style="@style/txt_PoppinsMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_12px"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:ellipsize="end"
                    android:hint="@string/lbl_roll_req"
                    android:inputType="textCapCharacters"
                    android:maxLength="10"
                    android:paddingTop="@dimen/_16px"
                    android:paddingBottom="@dimen/_16px"
                    android:singleLine="true"
                    android:textColor="@color/gray_2"
                    android:textColorHint="@color/gray_edt_hint_text"
                    android:textCursorDrawable="@drawable/cursor"
                    android:textSize="@dimen/_15sp"
                    tools:ignore="Autofill" />

                <TextView
                    android:id="@+id/btnCpFetch"
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/_6px"
                    android:text="@string/result_fetch_auto"
                    android:textColor="@color/app_bg_orange"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCpFetchStatus"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:textColor="@color/home_by_author"
                android:textSize="@dimen/_12sp"
                android:visibility="gone"
                tools:text="Looking up your details…"
                tools:visibility="visible" />

            <!-- 3. Department -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_reg_badge"
                    android:gravity="center"
                    android:text="@string/lbl_step_3"
                    android:textColor="@color/app_bg_orange"
                    android:textSize="@dimen/_12sp" />

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10px"
                    android:text="@string/lbl_department_req"
                    android:textColor="@color/home_by_author"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:background="@drawable/bg_reg_field"
                android:minHeight="@dimen/_55px">

                <Spinner
                    android:id="@+id/spDepartment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/_16px"
                    android:paddingEnd="@dimen/_40px"
                    android:spinnerMode="dropdown"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_16px"
                    android:src="@drawable/img_arrow_dropdown"
                    app:tint="@color/home_by_author"
                    tools:ignore="ContentDescription" />
            </RelativeLayout>

            <!-- 4. College -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18px"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/txt_OpenSansRomanBold"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_reg_badge"
                    android:gravity="center"
                    android:text="@string/lbl_step_4"
                    android:textColor="@color/app_bg_orange"
                    android:textSize="@dimen/_12sp" />

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10px"
                    android:text="@string/lbl_college_req"
                    android:textColor="@color/home_by_author"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8px"
                android:background="@drawable/bg_reg_field"
                android:minHeight="@dimen/_55px">

                <Spinner
                    android:id="@+id/spCollege"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/_16px"
                    android:paddingEnd="@dimen/_40px"
                    android:spinnerMode="dropdown"
                    tools:ignore="RtlSymmetry" />

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/_16px"
                    android:src="@drawable/img_arrow_dropdown"
                    app:tint="@color/home_by_author"
                    tools:ignore="ContentDescription" />
            </RelativeLayout>

            <!-- Why we ask -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20px"
                android:background="@drawable/bg_feed_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_12px">

                <ImageView
                    android:layout_width="@dimen/_20px"
                    android:layout_height="@dimen/_20px"
                    android:src="@drawable/ic_feed_book"
                    app:tint="@color/app_bg_orange"
                    tools:ignore="ContentDescription" />

                <TextView
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10px"
                    android:text="@string/lbl_complete_profile_why"
                    android:textColor="@color/gray_2"
                    android:textSize="@dimen/_13sp" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
