<?xml version="1.0" encoding="utf-8"?>
<!-- One semester: a white row card with the SGPA chip, opening to its mark sheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_authx_card_sm"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (tap to expand/collapse) -->
        <LinearLayout
            android:id="@+id/llSemHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="?attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_authx_icon_tile">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_result_school"
                    app:tint="@color/authx_coral"
                    android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/authx_text"
                    android:textSize="16sp"
                    android:fontFamily="@font/opensansromanextrabold" />

                <TextView
                    android:id="@+id/tvSemMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/authx_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/opensansromansemibold" />

                <LinearLayout
                    android:id="@+id/pillSemLocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_verified_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_result_verified"
                        android:contentDescription="@string/result_verified" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_verified"
                        android:textColor="@color/result_verified_green"
                        android:textSize="10sp"
                        android:fontFamily="@font/opensansromanbold" />
                </LinearLayout>
            </LinearLayout>

            <!-- SGPA chip -->
            <LinearLayout
                android:id="@+id/llSgpaChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_authx_coral_soft"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tvSemSgpa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/authx_coral"
                    android:textSize="17sp"
                    android:fontFamily="@font/opensansromanextrabold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_sgpa"
                    android:textColor="@color/authx_text_muted"
                    android:textSize="9sp"
                    android:fontFamily="@font/opensansromansemibold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivSemChevron"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_result_expand"
                app:tint="@color/authx_text_muted"
                android:contentDescription="@string/result_expand" />
        </LinearLayout>

        <!-- Subject table (collapsible) -->
        <LinearLayout
            android:id="@+id/llSubjectContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_authx_divider" />

            <!-- The mark sheet as a table. It scrolls sideways rather than
                 squeezing six columns into a phone width, and the header shares
                 the scroller with the rows so the columns stay lined up. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="154dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensansromanbold"
                            android:text="@string/result_col_subject"
                            android:textColor="@color/authx_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensansromanbold"
                            android:gravity="center"
                            android:text="@string/result_col_int"
                            android:textColor="@color/authx_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensansromanbold"
                            android:gravity="center"
                            android:text="@string/result_col_ext"
                            android:textColor="@color/authx_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="50dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensansromanbold"
                            android:gravity="center"
                            android:text="@string/result_col_total"
                            android:textColor="@color/authx_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensansromanbold"
                            android:gravity="center"
                            android:text="@string/result_col_gr"
                            android:textColor="@color/authx_text_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensansromanbold"
                            android:gravity="center"
                            android:text="@string/result_col_cr"
                            android:textColor="@color/authx_text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/bg_authx_divider" />

                    <!-- Subject rows injected here at runtime -->
                    <LinearLayout
                        android:id="@+id/llSubjectRows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
