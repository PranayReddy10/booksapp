<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <include
        android:id="@+id/toolbarMain"
        layout="@layout/row_toolbar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="150dp">

                <!-- Image carousel -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vpImages"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:background="@color/card_view_bg" />

                    <TextView
                        android:id="@+id/tvDetailDiscount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_shop_discount"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:fontFamily="@font/opensansromanextrabold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvImageCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_shop_discount"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:fontFamily="@font/opensansromanbold"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Name -->
                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/gray"
                    android:textSize="19sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/opensansromanextrabold" />

                <!-- Price row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvDetailPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/app_bg_orange"
                        android:textSize="24sp"
                        android:fontFamily="@font/opensansromanextrabold" />

                    <TextView
                        android:id="@+id/tvDetailRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/gray_2"
                        android:textSize="15sp"
                        android:fontFamily="@font/opensansromansemibold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvSaveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_save_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#2E7D32"
                        android:textSize="12sp"
                        android:fontFamily="@font/opensansromanbold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/shop_out_of_stock"
                    android:textColor="#E53935"
                    android:textSize="13sp"
                    android:fontFamily="@font/opensansromanbold"
                    android:visibility="gone" />

                <!-- Trust info pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_shop_info_pill"
                        android:padding="10dp"
                        android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Free Shipping" android:textColor="@color/gray"
                            android:textSize="11sp" android:fontFamily="@font/opensansromanbold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_shop_info_pill"
                        android:padding="10dp"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="3-5 Day Delivery" android:textColor="@color/gray"
                            android:textSize="11sp" android:fontFamily="@font/opensansromanbold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_shop_info_pill"
                        android:padding="10dp"
                        android:layout_marginStart="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Made in India" android:textColor="@color/gray"
                            android:textSize="11sp" android:fontFamily="@font/opensansromanbold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Personalise note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_shop_info_pill"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎨"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="@string/shop_personalise_note"
                        android:textColor="@color/gray"
                        android:textSize="12sp"
                        android:fontFamily="@font/opensansromansemibold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="#EEEEEE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:text="Product Details"
                    android:textColor="@color/gray"
                    android:textSize="15sp"
                    android:fontFamily="@font/opensansromanextrabold" />

                <TextView
                    android:id="@+id/tvDetailDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"
                    android:fontFamily="@font/opensansromansemibold" />

                <ProgressBar
                    android:id="@+id/progressDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="40dp"
                    android:theme="@style/ProgressBar" />

                <!-- Similar products -->
                <LinearLayout
                    android:id="@+id/llSimilar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#EEEEEE" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/shop_similar"
                        android:textColor="@color/gray"
                        android:textSize="16sp"
                        android:fontFamily="@font/opensansromanextrabold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSimilar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Sticky footer: Personalise & Buy + WhatsApp bulk -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="12dp"
            android:elevation="10dp">

            <TextView
                android:id="@+id/btnBuyNow"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:background="@drawable/bg_buy_gradient"
                android:text="@string/shop_buy_now"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/opensansromanbold"
                android:foreground="?attr/selectableItemBackground" />

            <LinearLayout
                android:id="@+id/btnBulkWhatsapp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_whatsapp_btn"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/shop_bulk_whatsapp"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="@font/opensansromanbold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
