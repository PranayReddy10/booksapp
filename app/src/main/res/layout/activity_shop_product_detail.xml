<?xml version="1.0" encoding="utf-8"?>
<!-- A shop product: the photo gallery with a floating back button, then a
     rounded sheet rising over it with name, price, stock, delivery info, the
     personalise note, details and similar products. Buy and WhatsApp bulk
     stay pinned to the bottom. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/authx_page">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="150dp">

            <!-- Image carousel -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/vpImages"
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:background="@color/authx_soft" />

                <TextView
                    android:id="@+id/tvDetailDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_shop_discount"
                    android:fontFamily="@font/opensansromanextrabold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="-25%"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvImageCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="40dp"
                    android:background="@drawable/bg_authx_glass"
                    android:backgroundTint="#66000000"
                    android:fontFamily="@font/opensansromanbold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="1 / 4"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Sheet over the photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-26dp"
                android:background="@drawable/bg_authx_sheet_top"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="22dp"
                android:paddingEnd="18dp">

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/opensansromanextrabold"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/authx_text"
                    android:textSize="20sp"
                    tools:text="Personalized Coffee Mug with Photo" />

                <!-- Price row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/opensansromanextrabold"
                        android:textColor="@color/authx_coral"
                        android:textSize="26sp"
                        tools:text="₹299" />

                    <TextView
                        android:id="@+id/tvDetailRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/opensansromansemibold"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="15sp"
                        android:visibility="gone"
                        tools:text="₹399"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvSaveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_save_badge"
                        android:fontFamily="@font/opensansromanbold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/authx_good"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Save ₹100"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/opensansromanbold"
                    android:text="@string/shop_out_of_stock"
                    android:textColor="@color/result_backlog_red"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Delivery info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_shop_info_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_authx_circle_soft">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/menu_shop"
                                    app:tint="@color/authx_coral"
                                    tools:ignore="ContentDescription" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensansromanbold"
                                android:gravity="center"
                                android:text="Free Shipping"
                                android:textColor="@color/authx_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_shop_info_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_authx_circle_soft">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_task_clock"
                                    app:tint="@color/authx_coral"
                                    tools:ignore="ContentDescription" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensansromanbold"
                                android:gravity="center"
                                android:text="3-5 Day Delivery"
                                android:textColor="@color/authx_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_shop_info_pill"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="10dp">

                            <FrameLayout
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_authx_circle_soft">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_picker_check"
                                    app:tint="@color/authx_coral"
                                    tools:ignore="ContentDescription" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensansromanbold"
                                android:gravity="center"
                                android:text="Made in India"
                                android:textColor="@color/authx_text"
                                android:textSize="11sp" />
                        </LinearLayout>

                </LinearLayout>

                <!-- Personalise note -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_authx_coral_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_compose_photo"
                        app:tint="@color/authx_coral"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/opensansromansemibold"
                        android:text="@string/shop_personalise_note"
                        android:textColor="@color/authx_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_authx_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/opensansromanextrabold"
                        android:text="Product Details"
                        android:textColor="@color/authx_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvDetailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/opensansromansemibold"
                        android:lineSpacingExtra="5dp"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/progressDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:theme="@style/ProgressBar" />
                </LinearLayout>
            </LinearLayout>

            <!-- Similar products -->
            <LinearLayout
                android:id="@+id/llSimilar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:fontFamily="@font/opensansromanextrabold"
                    android:text="@string/shop_similar"
                    android:textColor="@color/authx_text"
                    android:textSize="17sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSimilar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating back button over the photo -->
    <ImageView
        android:id="@+id/btnShopBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_authx_float_circle"
        android:contentDescription="@string/shop_title"
        android:elevation="6dp"
        android:padding="10dp"
        android:src="@drawable/ic_reg_back"
        app:tint="@color/authx_text" />

    <!-- Sticky footer: Personalise & Buy + WhatsApp bulk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/authx_card"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnBuyNow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_authx_cta"
            android:fontFamily="@font/opensansromanbold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/shop_buy_now"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/btnBulkWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_whatsapp_btn"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_whatsapp"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/opensansromanbold"
                android:text="@string/shop_bulk_whatsapp"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
