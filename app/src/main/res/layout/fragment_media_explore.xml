<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_screen_bg"
    tools:context="com.jntuh.books.MainActivity">

    <!-- Top bar: title + notification bell (with unread dot) + overflow -->
    <RelativeLayout
        android:id="@+id/exploreTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/feed_card_bg"
        android:paddingStart="@dimen/_16px"
        android:paddingTop="@dimen/_12px"
        android:paddingEnd="@dimen/_16px"
        android:paddingBottom="@dimen/_12px">

        <TextView
            android:id="@+id/tvExploreTitle"
            style="@style/txt_OpenSansRomanExtraBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/lbl_feed"
            android:textColor="@color/feed_name"
            android:textSize="@dimen/_22sp" />

        <ImageView
            android:id="@+id/ivExploreMenu"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_feed_menu"
            app:tint="@color/feed_icon"
            tools:ignore="ContentDescription" />

        <FrameLayout
            android:id="@+id/flBell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/_20px"
            android:layout_toStartOf="@+id/ivExploreMenu">

            <ImageView
                android:id="@+id/ivExploreBell"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@color/feed_icon"
                tools:ignore="ContentDescription" />

            <View
                android:id="@+id/viewBellDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_unread_dot"
                android:visibility="gone" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Filter chips: everything / photos only / videos only -->
    <HorizontalScrollView
        android:id="@+id/hsvFeedFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/exploreTopBar"
        android:background="@color/feed_card_bg"
        android:paddingStart="@dimen/_12px"
        android:paddingEnd="@dimen/_12px"
        android:paddingBottom="@dimen/_12px"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvChipAll"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_feed_chip_selected"
                android:paddingStart="@dimen/_20px"
                android:paddingTop="@dimen/_8px"
                android:paddingEnd="@dimen/_20px"
                android:paddingBottom="@dimen/_8px"
                android:text="@string/lbl_filter_all"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sp" />

            <TextView
                android:id="@+id/tvChipPhotos"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8px"
                android:background="@drawable/bg_feed_chip_normal"
                android:paddingStart="@dimen/_20px"
                android:paddingTop="@dimen/_8px"
                android:paddingEnd="@dimen/_20px"
                android:paddingBottom="@dimen/_8px"
                android:text="@string/lbl_filter_photos"
                android:textColor="@color/feed_name"
                android:textSize="@dimen/_13sp" />

            <TextView
                android:id="@+id/tvChipVideos"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8px"
                android:background="@drawable/bg_feed_chip_normal"
                android:paddingStart="@dimen/_20px"
                android:paddingTop="@dimen/_8px"
                android:paddingEnd="@dimen/_20px"
                android:paddingBottom="@dimen/_8px"
                android:text="@string/lbl_filter_videos"
                android:textColor="@color/feed_name"
                android:textSize="@dimen/_13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeExplore"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/hsvFeedFilters">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExplore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/_10px"
            android:paddingBottom="@dimen/_12px" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressExplore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:theme="@style/ProgressBar" />

    <include
        android:id="@+id/llNoData"
        layout="@layout/no_data_found"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" />
</RelativeLayout>
