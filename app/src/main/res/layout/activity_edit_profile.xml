<?xml version="1.0" encoding="utf-8"?>
<!-- Edit profile in the auth screens' look: a navy header carrying the photo, name
     and email, then white cards overlapping it - Account and Academic details - and
     the save action pinned to the bottom. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/authx_page">

    <!-- ===== Save ===== -->
    <LinearLayout
        android:id="@+id/llEditActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSave"
            style="@style/txtOpenSansRomanBold"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_authx_cta"
            android:elevation="4dp"
            android:gravity="center"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="@string/lbl_authx_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llEditActions"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Header: back, title, photo, name, email ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_authx_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="36dp"
                android:paddingEnd="22dp"
                android:paddingBottom="70dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/btnEditBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_authx_glass"
                        android:contentDescription="@string/profile_edt_title"
                        android:padding="9dp"
                        android:src="@drawable/ic_reg_back"
                        app:tint="@color/authx_on_header" />

                    <TextView
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="@string/profile_edt_title"
                        android:textColor="@color/authx_on_header"
                        android:textSize="@dimen/_18sp" />
                </RelativeLayout>

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_marginTop="18dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_authx_avatar_ring"
                        android:padding="6dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivUser"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/app_name"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/ic_launcher_round"
                            app:shapeAppearanceOverlay="@style/CircleImage"
                            app:strokeColor="@color/white"
                            app:strokeWidth="3dp" />
                    </FrameLayout>

                    <ImageView
                        android:id="@+id/ivEditIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_authx_edit_badge"
                        android:contentDescription="@string/lbl_authx_change_photo"
                        android:elevation="4dp"
                        android:padding="9dp"
                        android:src="@drawable/ic_result_edit"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvProfileName"
                    style="@style/txt_OpenSansRomanExtraBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/authx_on_header"
                    android:textSize="@dimen/_20sp" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/authx_on_header_muted"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>

            <!-- ===== Account ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="-48dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_authx_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/txt_OpenSansRomanExtraBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_authx_account"
                    android:textColor="@color/authx_text"
                    android:textSize="@dimen/_17sp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_name"
                    app:startIconDrawable="@drawable/ic_reg_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtName"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:hint="@string/lbl_authx_email"
                    app:endIconDrawable="@drawable/ic_reg_lock"
                    app:endIconMode="custom"
                    app:startIconDrawable="@drawable/ic_reg_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmail"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textEmailAddress"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:hint="@string/lbl_username_hint"
                    app:endIconDrawable="@drawable/ic_reg_lock"
                    app:endIconMode="custom"
                    app:startIconDrawable="@drawable/ic_reg_badge_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtUsername"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="text"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_phone"
                    app:startIconDrawable="@drawable/ic_reg_phone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPhone"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_authx_new_pass"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_reg_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPassword"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Gender: pick one; saved with the profile. -->
                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_gender_req" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llEpGenderMale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp">

                        <FrameLayout
                            android:id="@+id/ivEpGenderMaleDisc"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_gender_circle">

                            <ImageView
                                android:id="@+id/ivEpGenderMale"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_gender_male"
                                app:tint="@color/home_by_author"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvEpGenderMale"
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/lbl_gender_male"
                            android:textColor="@color/home_by_author"
                            android:textSize="@dimen/_13sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llEpGenderFemale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp">

                        <FrameLayout
                            android:id="@+id/ivEpGenderFemaleDisc"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_gender_circle">

                            <ImageView
                                android:id="@+id/ivEpGenderFemale"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_gender_female"
                                app:tint="@color/home_by_author"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvEpGenderFemale"
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/lbl_gender_female"
                            android:textColor="@color/home_by_author"
                            android:textSize="@dimen/_13sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llEpGenderOther"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="12dp"
                        android:paddingBottom="10dp">

                        <FrameLayout
                            android:id="@+id/ivEpGenderOtherDisc"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_gender_circle">

                            <ImageView
                                android:id="@+id/ivEpGenderOther"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_gender_other"
                                app:tint="@color/home_by_author"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvEpGenderOther"
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/lbl_gender_other"
                            android:textColor="@color/home_by_author"
                            android:textSize="@dimen/_13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Year is read-only; shown only when set. -->
                <LinearLayout
                    android:id="@+id/llYearRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_authx_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_year"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="@dimen/_13sp" />

                    <TextView
                        android:id="@+id/tvYearValue"
                        style="@style/txt_OpenSansRomanBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:singleLine="true"
                        android:textColor="@color/authx_text"
                        android:textSize="@dimen/_15sp"
                        tools:text="3rd Year" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Academic details (used by My Results) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_authx_card"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/txt_OpenSansRomanExtraBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_authx_academic"
                    android:textColor="@color/authx_text"
                    android:textSize="@dimen/_17sp" />

                <LinearLayout
                    android:id="@+id/llUniversityRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/AuthxLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/lbl_university" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_authx_outline"
                        android:minHeight="56dp">

                        <Spinner
                            android:id="@+id/spEditUniversity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:background="@android:color/transparent"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            tools:ignore="RtlSymmetry" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/img_arrow_dropdown"
                            app:tint="@color/authx_text_muted"
                            tools:ignore="ContentDescription" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDepartmentRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/AuthxLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_department" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_authx_outline"
                        android:minHeight="56dp">

                        <Spinner
                            android:id="@+id/spEditDepartment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:background="@android:color/transparent"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            tools:ignore="RtlSymmetry" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/img_arrow_dropdown"
                            app:tint="@color/authx_text_muted"
                            tools:ignore="ContentDescription" />
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCollegeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/AuthxLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_college" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_authx_outline"
                        android:minHeight="56dp">

                        <Spinner
                            android:id="@+id/spEditCollege"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:background="@android:color/transparent"
                            android:paddingStart="16dp"
                            android:paddingEnd="44dp"
                            tools:ignore="RtlSymmetry" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="16dp"
                            android:src="@drawable/img_arrow_dropdown"
                            app:tint="@color/authx_text_muted"
                            tools:ignore="ContentDescription" />
                    </RelativeLayout>
                </LinearLayout>

                <!-- Hall ticket: set once, then locked (results are keyed on it). -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/lbl_roll_number"
                    app:placeholderText="@string/result_hall_ticket_hint"
                    app:startIconDrawable="@drawable/ic_reg_badge_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRoll"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters"
                        android:maxLength="12" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvRollLockedNote"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_authx_soft"
                    android:drawablePadding="8dp"
                    android:lineSpacingExtra="2dp"
                    android:padding="12dp"
                    android:text="@string/msg_roll_locked"
                    android:textColor="@color/authx_text_muted"
                    android:textSize="@dimen/_12sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Regulation and degree: dropdown, with a box for "Others". -->
                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_regulation_label" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_authx_outline"
                    android:minHeight="56dp">

                    <Spinner
                        android:id="@+id/spProfileRegulation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        tools:ignore="RtlSymmetry" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/img_arrow_dropdown"
                        app:tint="@color/authx_text_muted"
                        tools:ignore="ContentDescription" />
                </RelativeLayout>

                <EditText
                    android:id="@+id/edtRegulationOther"
                    style="@style/AuthxFieldEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_authx_outline"
                    android:hint="@string/result_other_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColorHint="@color/authx_text_muted"
                    android:visibility="gone" />

                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_degree_label" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_authx_outline"
                    android:minHeight="56dp">

                    <Spinner
                        android:id="@+id/spProfileDegree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        tools:ignore="RtlSymmetry" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/img_arrow_dropdown"
                        app:tint="@color/authx_text_muted"
                        tools:ignore="ContentDescription" />
                </RelativeLayout>

                <EditText
                    android:id="@+id/edtDegreeOther"
                    style="@style/AuthxFieldEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_authx_outline"
                    android:hint="@string/result_other_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColorHint="@color/authx_text_muted"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
