<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up wizard in the login screen's look: a navy header carrying the progress
     rail and the step's heading, a white card overlapping it with that step's fields,
     and one primary action pinned to the bottom. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/authx_page">

    <!-- ===== Header: back, progress, step badge and heading ===== -->
    <LinearLayout
        android:id="@+id/linearWelcomeBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_authx_header"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="36dp"
        android:paddingEnd="22dp"
        android:paddingBottom="64dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnRegBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_authx_glass"
                android:padding="9dp"
                android:src="@drawable/ic_reg_back"
                app:tint="@color/authx_on_header"
                tools:ignore="ContentDescription" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="12dp"
                android:layout_toStartOf="@+id/tvRegStepCount"
                android:layout_toEndOf="@+id/btnRegBack"
                android:orientation="horizontal">

                <View
                    android:id="@+id/vRegProgress1"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reg_progress_on" />

                <View
                    android:id="@+id/vRegProgress2"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reg_progress_off" />

                <View
                    android:id="@+id/vRegProgress3"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reg_progress_off" />

                <View
                    android:id="@+id/vRegProgress4"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reg_progress_off" />

                <View
                    android:id="@+id/vRegProgress5"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_reg_progress_off" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRegStepCount"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_authx_glass"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:singleLine="true"
                android:textColor="@color/authx_on_header"
                android:textSize="@dimen/_13sp"
                tools:text="1 / 5" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/flRegBadge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_authx_glass">

                <ImageView
                    android:id="@+id/ivRegStepIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_reg_mail"
                    app:tint="@color/authx_on_header"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtWelcomeBack"
                    style="@style/txt_OpenSansRomanExtraBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_reg_step1_title"
                    android:textColor="@color/authx_on_header"
                    android:textSize="@dimen/_22sp" />

                <TextView
                    android:id="@+id/txtLetsLoginA"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:text="@string/lbl_reg_step1_sub"
                    android:textColor="@color/authx_on_header_muted"
                    android:textSize="@dimen/_14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Bottom action ===== -->
    <LinearLayout
        android:id="@+id/llRegActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            style="@style/txtOpenSansRomanBold"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_authx_cta"
            android:elevation="4dp"
            android:gravity="center"
            android:singleLine="true"
            android:stateListAnimator="@null"
            android:text="@string/lbl_continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtConfirmation"
                style="@style/txtOpenSansRomanSemiBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:singleLine="true"
                android:text="@string/msg_already_have_acc"
                android:textColor="@color/authx_text_muted"
                android:textSize="@dimen/_14sp" />

            <TextView
                android:id="@+id/tvRegLogIn"
                style="@style/txt_OpenSansRomanBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/reg_log_in"
                android:textColor="@color/authx_coral"
                android:textSize="@dimen/_14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Step card ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/llRegActions"
        android:layout_below="@+id/linearWelcomeBack"
        android:layout_marginTop="-44dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/linearLoginFild"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_authx_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Step 1: account -->
            <LinearLayout
                android:id="@+id/llRegStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:hint="@string/lbl_email"
                    app:startIconDrawable="@drawable/ic_reg_mail">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegEmail"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_pass_req"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_reg_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegPass"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_reg_confirm_pass"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_reg_lock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegPassConfirm"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 2: gender and phone -->
            <LinearLayout
                android:id="@+id/llRegStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/lbl_gender_req" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/llGenderMale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:id="@+id/ivGenderMaleDisc"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_gender_circle">

                            <ImageView
                                android:id="@+id/ivGenderMale"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_gender_male"
                                app:tint="@color/home_by_author"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/ivGenderMaleLabel"
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/lbl_gender_male"
                            android:textColor="@color/home_by_author"
                            android:textSize="@dimen/_14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGenderFemale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:id="@+id/ivGenderFemaleDisc"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_gender_circle">

                            <ImageView
                                android:id="@+id/ivGenderFemale"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_gender_female"
                                app:tint="@color/home_by_author"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/ivGenderFemaleLabel"
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/lbl_gender_female"
                            android:textColor="@color/home_by_author"
                            android:textSize="@dimen/_14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llGenderOther"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_authx_outline"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="14dp"
                        android:paddingBottom="12dp">

                        <FrameLayout
                            android:id="@+id/ivGenderOtherDisc"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_gender_circle">

                            <ImageView
                                android:id="@+id/ivGenderOther"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_gender_other"
                                app:tint="@color/home_by_author"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/ivGenderOtherLabel"
                            style="@style/txt_OpenSansRomanBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/lbl_gender_other"
                            android:textColor="@color/home_by_author"
                            android:textSize="@dimen/_14sp" />
                    </LinearLayout>
                </LinearLayout>

                <Spinner
                    android:id="@+id/spRegGender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="@string/lbl_phone_req"
                    app:startIconDrawable="@drawable/ic_reg_phone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegPhone"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 3: university and hall ticket -->
            <LinearLayout
                android:id="@+id/llRegStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/lbl_university_req" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_authx_outline"
                    android:minHeight="56dp">

                    <Spinner
                        android:id="@+id/spRegUniversity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        android:spinnerMode="dropdown"
                        tools:ignore="RtlSymmetry" />

                    <ImageView
                        android:id="@+id/ivRegUniversityArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_authx_chevron_down"
                        app:tint="@color/authx_text_muted"
                        tools:ignore="ContentDescription" />
                </RelativeLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/lbl_roll_req"
                    app:startIconDrawable="@drawable/ic_reg_badge_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegRoll"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvRegFetchStatus"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_authx_soft"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:textColor="@color/authx_text"
                    android:textSize="@dimen/_13sp"
                    android:visibility="gone"
                    tools:text="Looking up your details…"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Step 4: details -->
            <LinearLayout
                android:id="@+id/llRegStep4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:hint="@string/lbl_name"
                    app:startIconDrawable="@drawable/ic_reg_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegName"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/lbl_reg_father"
                    app:startIconDrawable="@drawable/ic_reg_person">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegFather"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_department_req" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_authx_outline"
                    android:minHeight="56dp">

                    <Spinner
                        android:id="@+id/spRegDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        android:spinnerMode="dropdown"
                        tools:ignore="RtlSymmetry" />

                    <ImageView
                        android:id="@+id/ivRegDepartmentArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_authx_chevron_down"
                        app:tint="@color/authx_text_muted"
                        tools:ignore="ContentDescription" />
                </RelativeLayout>

                <TextView
                    style="@style/AuthxLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_college_req" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_authx_outline"
                    android:minHeight="56dp">

                    <Spinner
                        android:id="@+id/spRegCollege"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:paddingStart="16dp"
                        android:paddingEnd="44dp"
                        android:spinnerMode="dropdown"
                        tools:ignore="RtlSymmetry" />

                    <ImageView
                        android:id="@+id/ivRegCollegeArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_authx_chevron_down"
                        app:tint="@color/authx_text_muted"
                        tools:ignore="ContentDescription" />
                </RelativeLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/AuthxField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="@string/lbl_reg_regulation"
                    app:startIconDrawable="@drawable/ic_reg_badge_id">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtRegRegulation"
                        style="@style/AuthxFieldEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        tools:ignore="Autofill" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 5: review -->
            <LinearLayout
                android:id="@+id/llRegStep5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvRegSummary"
                    style="@style/txtOpenSansRomanSemiBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_authx_soft"
                    android:lineSpacingExtra="7dp"
                    android:padding="16dp"
                    android:textColor="@color/authx_text"
                    android:textSize="@dimen/_14sp"
                    tools:text="Name: Pranay" />

                <RelativeLayout
                    android:id="@+id/linearRowPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <cn.refactor.library.SmoothCheckBox
                        android:id="@+id/cbRegPrivacyTerms"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        app:color_checked="@color/authx_coral"
                        app:color_tick="@color/white"
                        app:color_unchecked="@color/authx_field"
                        app:color_unchecked_stroke="@color/authx_field_stroke" />

                    <TextView
                        android:id="@+id/txtPrivacyText"
                        style="@style/txtOpenSansRomanSemiBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@+id/cbRegPrivacyTerms"
                        android:singleLine="true"
                        android:text="@string/msg_by_signing_up_y"
                        android:textColor="@color/authx_text_muted"
                        android:textSize="@dimen/_13sp" />

                    <TextView
                        android:id="@+id/tvRegPrivacyTerms"
                        style="@style/txt_OpenSansRomanBold"
