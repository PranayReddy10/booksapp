<?xml version="1.0" encoding="utf-8"?>
<!-- Photo / video chips are RadioButtons, so the checked state drives the fill.
     Without this both chips looked identical and nothing showed as selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_compose_chip_on" android:state_checked="true" />
    <item android:drawable="@drawable/bg_compose_chip_off" />
</selector>
