<?xml version="1.0" encoding="utf-8"?>
<!-- Primary auth action, with a pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_coral_end" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/authx_coral_end"
                android:startColor="@color/authx_coral"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
