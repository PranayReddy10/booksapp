<?xml version="1.0" encoding="utf-8"?>
<!-- Small coral-outlined action beside a field (hall ticket "Look up"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_soft" />
            <stroke android:width="1.5dp" android:color="@color/authx_coral" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_field" />
            <stroke android:width="1.5dp" android:color="@color/authx_coral" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
