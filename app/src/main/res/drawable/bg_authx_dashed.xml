<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed drop area for choosing the book file. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_coral_tint" />
            <stroke android:width="1.5dp" android:color="@color/authx_coral"
                android:dashWidth="7dp" android:dashGap="5dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_soft" />
            <stroke android:width="1.5dp" android:color="@color/authx_coral"
                android:dashWidth="7dp" android:dashGap="5dp" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
