<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary auth action (Google) and dropdown boxes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_soft" />
            <stroke android:width="1dp" android:color="@color/authx_field_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/authx_field" />
            <stroke android:width="1dp" android:color="@color/authx_field_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
