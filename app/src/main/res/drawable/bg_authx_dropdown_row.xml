<?xml version="1.0" encoding="utf-8"?>
<!-- A row in an opened dropdown: soft highlight when pressed or chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/authx_soft" /></shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle"><solid android:color="@color/authx_coral_tint" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
