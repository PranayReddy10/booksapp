<?xml version="1.0" encoding="utf-8"?>
<!-- Soft warm wash behind the home screen: tinted at the top, fading to near-white
     so covers and cards stay the brightest things on the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/home_grad_top"
        android:endColor="@color/home_grad_bottom"
        android:type="linear" />
</shape>
